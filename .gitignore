# ------------------------------------------------------------------
# Data: never commit datasets or generated outputs
# ------------------------------------------------------------------
# Everything inside these folders is ignored by default: downloaded data,
# harmonised tables, generated population builds, and experiment results.
# Only folder placeholders and README files stay tracked.
data/raw/*
data/processed/*
data/populations/*
data/households/*
data/results/*
!data/*/.gitkeep
!data/*/README.md

# data/manifest.yaml (dataset metadata, no data) is intentionally tracked.
!data/manifest.yaml

# Extra safety: common dataset formats anywhere under data/
data/**/*.csv
data/**/*.tsv
data/**/*.txt
data/**/*.xlsx
data/**/*.xls
data/**/*.json
data/**/*.jsonl
data/**/*.parquet
data/**/*.feather
data/**/*.arrow
data/**/*.pkl
data/**/*.sav
data/**/*.dta
data/**/*.sas7bdat
data/**/*.db
data/**/*.sqlite
data/**/*.zip
data/**/*.gz

# Experiment outputs (instruments and configurations stay tracked)
experiments/outputs/
experiments/results/
experiments/matraix_simulation/runs/
experiments/matraix_simulation/.env

# Databases created by the registry or local analytics
*.db
*.sqlite
*.sqlite3
*.duckdb
*.duckdb.wal

# Logs
logs/
*.log

# LLM / model-provider response caches (may contain generated text)
.cache/
llm_cache/
.llm_cache/
/cache/

# Small, clearly artificial test fixtures ARE tracked:
# keep them in tests/fixtures/, never under data/.

# ------------------------------------------------------------------
# Secrets and credentials: never commit
# ------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials*.json

# ------------------------------------------------------------------
# Python
# ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/
.ipynb_checkpoints/
build/
dist/

# ------------------------------------------------------------------
# Node / Next.js (planned frontend)
# ------------------------------------------------------------------
node_modules/
.next/
out/
coverage/
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------------------------------
# Operating system and editors
# ------------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
.claude/settings.local.json

# ------------------------------------------------------------------
# Research workbench (frontend test output)
# ------------------------------------------------------------------
frontend/test-results/
frontend/playwright-report/

# Unified population workflow source and tests (not packaging build output).
!src/societytwin/build/
!src/societytwin/build/**
!tests/build/
!tests/build/**
