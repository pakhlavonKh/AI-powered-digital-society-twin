# Copy to .env only if you want local live execution. Do not commit .env.

# Path to a local checkout of the MatrAIx framework.
# Leave unset if it is next to the SocietyTwin checkout as ../MatrAIx-Persona-8B.
MATRAIX_ROOT=../MatrAIx-Persona-8B

# Select one provider/model using MatrAIx model naming, for example:
# MATRIX_PERSONA_MODEL=anthropic/claude-sonnet-4-5
# MATRIX_PERSONA_MODEL=openai/gpt-4.1
MATRIX_PERSONA_MODEL=

# Provide exactly the key(s) required by your selected provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
DASHSCOPE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
ZAI_API_KEY=
